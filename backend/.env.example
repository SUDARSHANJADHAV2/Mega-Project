# KrushiAI V2.0 Environment Variables

# ==========================================
# 1. AI Assistant (LLM) Configuration
# ==========================================
# Primary: Google Gemini (Get key at https://aistudio.google.com/)
GEMINI_API_KEY_1="your_gemini_key_here"
# Optional: Fallback Keys for Enterprise load balancing
GEMINI_API_KEY_2="your_gemini_key_2_here"
GEMINI_API_KEY_3="your_gemini_key_3_here"

# Secondary Fallback: Groq (Get key at https://console.groq.com/)
GROQ_API_KEY="your_groq_key_here"

# ==========================================
# 2. Live Market Data (Agmarknet)
# ==========================================
# Get API key from https://data.gov.in/
DATA_GOV_API_KEY="your_data_gov_in_key_here"

# ==========================================
# 3. Security & App Configuration
# ==========================================
# JWT Secret Key for User Authentication
JWT_SECRET_KEY="krushiai_super_secret_enterprise_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080" # 7 Days

# ==========================================
# 4. Storage & Database (Optional/Advanced)
# ==========================================
# SQLite is used locally by default.
# DATABASE_URL="postgresql://user:password@localhost/dbname" 
